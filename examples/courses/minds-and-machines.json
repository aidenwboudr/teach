 "assignments": [
  {
   "id": "aa1-written",
   "kind": "argument-analysis",
   "title": "Argument analysis 1 (written)",
   "prompt": "Write 2-3 pages providing a reconstruction and analysis of the brain simulator reply and Searle's response. (Rest paraphrased: find the reply in 'Minds, Brains, and Programs'; lay out Searle's rebuttal as premises and a conclusion of one sentence each, labelling each line assumption or inference; explain it in your own words; judge validity and plausibility and say which extra premises would make it valid.)",
   "length": "2-3 pages",
   "unit": 1,
   "rubric": [
    {
     "criterion": "Reconstruction",
     "points": 8,
     "detail": "The argument as numbered premises and a conclusion, one sentence each, each line labelled assumption or inference."
    },
    {
     "criterion": "Faithful to the text",
     "points": 4,
     "detail": "It is the argument the author actually gives, located in the reading, not a stronger or weaker one."
    },
    {
     "criterion": "Explanation",
     "points": 4,
     "detail": "Each premise explained in your own words: what it says and why the author holds it."
    },
    {
     "criterion": "Evaluation",
     "points": 8,
     "detail": "Is it valid? If not, what extra premise would make it valid? Which premise is weakest and why? A verdict, argued."
    },
    {
     "criterion": "Clarity and form",
     "points": 6,
     "detail": "2-3 pages, organised around a thesis, claims attributed to the text accurately (the course's paper guidelines)."
    }
   ],
   "rubricSource": "built from the assignment's own instructions (premise-conclusion form, labelling, validity and plausibility) and the course's paper guidelines; neither edition publishes a rubric",
   "points": 30,
   "url": "https://ocw.mit.edu/courses/24-09-minds-and-machines-fall-2011/pages/assignments/"
